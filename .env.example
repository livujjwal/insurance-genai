# ==========================================
# Enterprise Insurance Gen-AI Assistant
# Environment Configuration Template
# ==========================================

# --- General & App Settings ---
ENVIRONMENT=development
DEBUG=true
APP_NAME="Insurance Claims & Policy Intelligence Assistant"
API_V1_STR="/api/v1"
HOST_BACKEND_PORT=8005
HOST_FRONTEND_PORT=3000

# --- Security & JWT ---
# Generate with: openssl rand -hex 32
SECRET_KEY=supersecretjwtkeychangeinproductionminimum32characterslong
# Fernet 32-byte url-safe base64 key for encrypting provider credentials at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=D7MvZ8q7X8zBqG2WjX8_4T7fN_3kY9pQ5mR1sT3vW4Y=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Initial Seed Admin ---
INITIAL_ADMIN_EMAIL=admin@insurance.internal
INITIAL_ADMIN_PASSWORD=AdminSecurePass123!
INITIAL_ADMIN_NAME="System Administrator"

# --- Database (PostgreSQL 16 + pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=insurance_genai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
HOST_POSTGRES_PORT=5435
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/insurance_genai

# --- Cache, Denylist & Queue (Redis 7) ---
REDIS_HOST=redis
REDIS_PORT=6379
HOST_REDIS_PORT=6381
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# --- Storage ---
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=25

# --- LLM Providers Defaults (optional overrides) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Rate Limiting ---
LOGIN_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_MINUTE=60

# --- Frontend Next.js Public Vars ---
NEXT_PUBLIC_API_URL=http://localhost:8005/api/v1
